{
  "schemaVersion": 1,
  "adapter": "sealed-command-v1",
  "target": "src/ttl_cache.py",
  "testKind": "python-behavior",
  "command": [
    "python3",
    "sealed/tests/evaluate_candidate.py",
    "{candidate}"
  ],
  "cases": [
    {
      "name": "deadline equality",
      "condition": "now=deadline",
      "expected": "KeyError"
    },
    {
      "name": "copy in/out",
      "condition": "mutate returned dict",
      "expected": "stored dict unchanged"
    },
    {
      "name": "ttl",
      "condition": "zero",
      "expected": "ValueError"
    }
  ]
}
