{
  "schemaVersion": 1,
  "adapter": "sealed-command-v1",
  "target": "src/Gateway.Routing/RouteTemplate.cs",
  "testKind": "dotnet-behavior",
  "command": [
    "python3",
    "sealed/tests/evaluate_candidate.py",
    "{candidate}"
  ],
  "cases": [
    {
      "name": "duplicate separators",
      "condition": "//Orders///{OrderId}/",
      "expected": "/orders/{OrderId}"
    },
    {
      "name": "root",
      "condition": "/",
      "expected": "/"
    },
    {
      "name": "blank",
      "condition": "   ",
      "expected": "ArgumentException"
    }
  ]
}
