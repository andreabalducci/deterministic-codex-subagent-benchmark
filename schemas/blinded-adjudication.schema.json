{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/codex-benchmark/blinded-adjudication.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordKind", "blinded", "protocolHash", "catalogHash", "raterCount", "assignmentHash", "revealHash", "ratingsHash", "assignment", "reveal", "ratingRecords", "auditCases", "families"],
  "properties": {
    "schemaVersion": {"const": 2},
    "recordKind": {"const": "blinded-adjudication"},
    "blinded": {"const": true},
    "protocolHash": {"$ref": "#/$defs/hash"},
    "catalogHash": {"$ref": "#/$defs/hash"},
    "raterCount": {"type": "integer", "minimum": 2},
    "assignmentHash": {"$ref": "#/$defs/hash"},
    "revealHash": {"$ref": "#/$defs/hash"},
    "ratingsHash": {"$ref": "#/$defs/hash"},
    "assignment": {"type": "object"},
    "reveal": {"type": "object"},
    "ratingRecords": {"type": "array", "minItems": 2, "items": {"type": "object"}},
    "auditCases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["caseId", "catalogFamilyId", "taskId", "sourceType", "automatedAccepted", "humanRatings", "consensusAccepted", "resolved"],
        "properties": {
          "caseId": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
          "catalogFamilyId": {"type": "string", "minLength": 1},
          "taskId": {"type": "string", "minLength": 1},
          "sourceType": {"enum": ["reference", "negative-mutant"]},
          "automatedAccepted": {"type": "boolean"},
          "humanRatings": {"type": "array", "minItems": 2, "items": {"type": "boolean"}},
          "consensusAccepted": {"type": ["boolean", "null"]},
          "resolved": {"type": "boolean"}
        }
      }
    },
    "families": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["catalogFamilyId", "sampleSize", "agreement", "unresolvedDisagreements"],
        "properties": {
          "catalogFamilyId": {"type": "string", "minLength": 1},
          "sampleSize": {"type": "integer", "minimum": 1},
          "agreement": {"type": "number", "minimum": 0, "maximum": 1},
          "unresolvedDisagreements": {"type": "integer", "minimum": 0}
        }
      }
    }
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
