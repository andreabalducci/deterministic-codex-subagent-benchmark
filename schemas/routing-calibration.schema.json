{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/codex-benchmark/routing-calibration.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordKind", "backend", "catalogHash", "evaluatorImage", "evaluatorImageId", "passed", "cases"],
  "properties": {
    "schemaVersion": {"const": 1},
    "recordKind": {"const": "routing-calibration"},
    "backend": {"const": "docker"},
    "catalogHash": {"$ref": "#/$defs/hash"},
    "evaluatorImage": {"type": "string", "minLength": 1},
    "evaluatorImageId": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "passed": {"type": "boolean"},
    "cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["template", "case", "expected", "actual"],
        "properties": {
          "template": {"type": "string", "minLength": 1},
          "case": {"enum": ["reference", "mutant", "equivalent-positive", "schema-extra-mutant"]},
          "expected": {"enum": ["PASS", "FAIL"]},
          "actual": {"enum": ["PASS", "FAIL"]}
        }
      }
    }
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
