{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/codex-benchmark/evidence-bundle.schema.json",
  "type": "object",
  "required": ["schemaVersion", "recordKind", "fixtureId", "protocol", "outcomes", "aggregate", "mapping", "provenance", "audit"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "recordKind": { "const": "published-evidence" },
    "fixtureId": { "type": "string", "minLength": 1 },
    "protocol": { "type": "object", "required": ["plan", "fixtureManifest", "matrix"], "properties": { "plan": { "$ref": "#/$defs/plan" }, "fixtureManifest": { "$ref": "#/$defs/fixtureManifest" }, "matrix": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/configuration" } } }, "additionalProperties": false },
    "outcomes": { "type": "array", "minItems": 1, "items": { "allOf": [{ "$ref": "#/$defs/publishedOutcome" }, { "if": { "properties": { "status": { "const": "PASS" } } }, "then": { "properties": { "failureKind": { "const": null } } }, "else": { "properties": { "failureKind": { "type": "string" } } } }] } },
    "aggregate": { "$ref": "#/$defs/aggregate" },
    "mapping": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/mapping" } },
    "provenance": { "$ref": "#/$defs/provenance" },
    "audit": { "type": "object", "required": ["planHash", "fixtureManifestHash", "promptHash", "sourceResultHashes", "aggregateHash", "records"], "properties": { "planHash": { "$ref": "#/$defs/hash" }, "fixtureManifestHash": { "$ref": "#/$defs/hash" }, "promptHash": { "$ref": "#/$defs/hash" }, "sourceResultHashes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/hash" } }, "aggregateHash": { "$ref": "#/$defs/hash" }, "records": { "type": "array", "items": { "$ref": "#/$defs/auditRecord" } } }, "additionalProperties": false }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "configuration": { "type": "object", "required": ["id", "model", "reasoningEffort"], "properties": { "id": { "type": "string", "minLength": 1 }, "model": { "type": "string", "minLength": 1 }, "reasoningEffort": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "job": { "type": "object", "required": ["runId", "trial", "orderPosition", "machineId", "id", "model", "reasoningEffort"], "properties": { "runId": { "type": "string", "pattern": "^[0-9a-f]{16}$" }, "trial": { "type": "integer", "minimum": 0 }, "orderPosition": { "type": "integer", "minimum": 0 }, "machineId": { "type": "string", "minLength": 1 }, "id": { "type": "string", "minLength": 1 }, "model": { "type": "string", "minLength": 1 }, "reasoningEffort": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "plan": { "type": "object", "required": ["schemaVersion", "fixtureId", "seed", "trials", "machines", "jobs"], "properties": { "schemaVersion": { "const": 1 }, "fixtureId": { "type": "string", "minLength": 1 }, "seed": { "type": "string", "minLength": 1 }, "trials": { "type": "integer", "minimum": 1 }, "machines": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "jobs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/job" } } }, "additionalProperties": false },
    "fixtureManifest": { "type": "object", "required": ["schemaVersion", "fixtureId", "files"], "properties": { "schemaVersion": { "const": 1 }, "fixtureId": { "type": "string", "minLength": 1 }, "files": { "type": "object", "additionalProperties": { "$ref": "#/$defs/hash" } } }, "additionalProperties": false },
    "mapping": { "type": "object", "required": ["runId", "model", "reasoningEffort", "machineId", "trial", "orderPosition"], "properties": { "runId": { "type": "string", "pattern": "^[0-9a-f]{16}$" }, "model": { "type": "string", "minLength": 1 }, "reasoningEffort": { "type": "string", "minLength": 1 }, "machineId": { "type": "string", "minLength": 1 }, "trial": { "type": "integer", "minimum": 0 }, "orderPosition": { "type": "integer", "minimum": 0 } }, "additionalProperties": false },
    "platform": { "type": "object", "required": ["system", "release", "machine", "python"], "properties": { "system": { "type": "string" }, "release": { "type": "string" }, "machine": { "type": "string" }, "python": { "type": "string" } }, "additionalProperties": false },
    "imageInfo": { "type": ["object", "null"], "required": ["tag", "id", "repoDigests", "os", "architecture", "specHash"], "properties": { "tag": { "type": "string", "minLength": 1 }, "id": { "type": "string", "minLength": 1 }, "repoDigests": { "type": "array", "items": { "type": "string" } }, "os": { "type": ["string", "null"] }, "architecture": { "type": ["string", "null"] }, "specHash": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" } }, "additionalProperties": false },
    "behaviorOutcome": { "type": "object", "required": ["name", "outcome"], "properties": { "name": { "enum": ["constructor validation", "same-key misses are single flight", "different keys load concurrently", "TTL starts at successful completion and expires at boundary", "failed load is retried", "one cancelled waiter does not cancel shared load", "all waiters may cancel while successful load remains cached", "invalidation supersedes an older in-flight generation", "public API contract"] }, "outcome": { "enum": ["PASS", "FAIL", "NOT_RUN", "AMBIGUOUS"] } }, "additionalProperties": false },
    "publishedAttempt": { "type": "object", "required": ["command", "exitCode", "timedOut", "launcherFailure", "outputLimitExceeded", "durationSeconds", "stdoutBytes", "stdoutSha256", "stderrBytes", "stderrSha256"], "properties": { "command": { "type": "array", "items": { "type": "string" } }, "exitCode": { "type": ["integer", "null"] }, "timedOut": { "type": "boolean" }, "launcherFailure": { "type": "boolean" }, "outputLimitExceeded": { "type": "boolean" }, "durationSeconds": { "type": "number", "minimum": 0 }, "stdoutBytes": { "type": "integer", "minimum": 0 }, "stdoutSha256": { "$ref": "#/$defs/hash" }, "stderrBytes": { "type": "integer", "minimum": 0 }, "stderrSha256": { "$ref": "#/$defs/hash" } }, "additionalProperties": false },
    "publishedTest": { "type": "object", "required": ["name", "attempts", "hadTimeout", "confirmedTimeout"], "properties": { "name": { "type": "string", "minLength": 1 }, "attempts": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/publishedAttempt" } }, "hadTimeout": { "type": "boolean" }, "confirmedTimeout": { "type": "boolean" }, "behaviors": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/behaviorOutcome" } } }, "additionalProperties": false },
    "publishedOutcome": { "type": "object", "required": ["runId", "fixtureManifestHash", "candidateHash", "promptHash", "status", "failureKind", "durationSeconds", "generationDurationSeconds", "repeatCount", "backend", "isolation", "integrityViolations", "policyViolations", "manifestErrors", "platform", "provenance", "evaluatorImage", "generatorImage", "tests"], "properties": { "runId": { "type": "string", "pattern": "^[0-9a-f]{16}$" }, "fixtureManifestHash": { "$ref": "#/$defs/hash" }, "candidateHash": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }, "promptHash": { "$ref": "#/$defs/hash" }, "status": { "enum": ["PASS", "CANDIDATE_FAILURE"] }, "failureKind": { "type": ["string", "null"], "enum": [null, "timeout", "output-limit", "test", "build", "test-marker", "integrity", "policy", "generation-timeout", "generation-output-limit", "generation-exit", "generation-unchanged"] }, "durationSeconds": { "type": ["number", "null"], "minimum": 0 }, "generationDurationSeconds": { "type": "number", "minimum": 0 }, "repeatCount": { "type": "integer", "minimum": 1 }, "backend": { "const": "docker" }, "isolation": { "const": "container-strong" }, "integrityViolations": { "type": "array", "items": { "type": "string" } }, "policyViolations": { "type": "array", "items": { "type": "string" } }, "manifestErrors": { "type": "array", "items": { "type": "string" } }, "platform": { "$ref": "#/$defs/platform" }, "provenance": { "$ref": "#/$defs/provenance" }, "evaluatorImage": { "$ref": "#/$defs/imageInfo" }, "generatorImage": { "$ref": "#/$defs/imageInfo" }, "tests": { "type": "array", "items": { "$ref": "#/$defs/publishedTest" } } }, "allOf": [{ "anyOf": [{ "properties": { "failureKind": { "enum": ["generation-timeout", "generation-output-limit", "generation-exit", "generation-unchanged"] }, "durationSeconds": { "type": "null" } } }, { "properties": { "failureKind": { "enum": [null, "timeout", "output-limit", "test", "build", "test-marker", "integrity", "policy"] }, "durationSeconds": { "type": "number", "minimum": 0 } } }] }], "additionalProperties": false },
    "machineSummary": { "type": "object", "required": ["runs", "observed", "resolved", "passes"], "properties": { "runs": { "type": "integer", "minimum": 0 }, "observed": { "type": "integer", "minimum": 0 }, "resolved": { "type": "integer", "minimum": 0 }, "passes": { "type": "integer", "minimum": 0 } }, "additionalProperties": false },
    "behaviorSummary": { "type": "object", "required": ["plannedRuns", "passes", "failures", "notRun", "ambiguous", "withoutHiddenRun", "missing", "passRate", "wilson95"], "properties": { "plannedRuns": { "type": "integer", "minimum": 1 }, "passes": { "type": "integer", "minimum": 0 }, "failures": { "type": "integer", "minimum": 0 }, "notRun": { "type": "integer", "minimum": 0 }, "ambiguous": { "type": "integer", "minimum": 0 }, "withoutHiddenRun": { "type": "integer", "minimum": 0 }, "missing": { "type": "integer", "minimum": 0, "maximum": 0 }, "passRate": { "type": "number", "minimum": 0, "maximum": 1 }, "wilson95": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 0, "maximum": 1 } } }, "additionalProperties": false },
    "groupSummary": { "type": "object", "required": ["plannedRuns", "observedRuns", "totalRuns", "eligibleRuns", "passes", "passRate", "wilson95", "observedResolvedPassRate", "medianEvaluationSeconds", "evaluationIqrSeconds", "medianGenerationSeconds", "generationIqrSeconds", "byMachine", "statuses", "failureKinds", "behaviors"], "properties": { "plannedRuns": { "type": "integer", "minimum": 1 }, "observedRuns": { "type": "integer", "minimum": 0 }, "totalRuns": { "type": "integer", "minimum": 0 }, "eligibleRuns": { "type": "integer", "minimum": 0 }, "passes": { "type": "integer", "minimum": 0 }, "passRate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }, "wilson95": { "type": ["array", "null"], "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 0, "maximum": 1 } }, "observedResolvedPassRate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }, "medianEvaluationSeconds": { "type": ["number", "null"], "minimum": 0 }, "evaluationIqrSeconds": { "type": ["array", "null"], "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 0 } }, "medianGenerationSeconds": { "type": ["number", "null"], "minimum": 0 }, "generationIqrSeconds": { "type": ["array", "null"], "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 0 } }, "byMachine": { "type": "object", "additionalProperties": { "$ref": "#/$defs/machineSummary" } }, "statuses": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }, "failureKinds": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }, "behaviors": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/behaviorSummary" } } }, "additionalProperties": false },
    "aggregate": { "type": "object", "required": ["schemaVersion", "planHash", "complete", "missingRunIds", "unresolvedRunIds", "duplicateCandidateHashes", "groups"], "properties": { "schemaVersion": { "const": 1 }, "planHash": { "$ref": "#/$defs/hash" }, "complete": { "const": true }, "missingRunIds": { "type": "array", "maxItems": 0 }, "unresolvedRunIds": { "type": "array", "maxItems": 0 }, "duplicateCandidateHashes": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 2 } }, "groups": { "type": "object", "additionalProperties": { "$ref": "#/$defs/groupSummary" } } }, "additionalProperties": false },
    "queueAudit": { "type": "object", "required": ["continuedAfterUnresolvedRunIds"], "properties": { "continuedAfterUnresolvedRunIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[0-9a-f]{16}$" } } }, "additionalProperties": false },
    "replacementAudit": { "type": "object", "required": ["previousResultHash", "previousStatus", "reason", "archivedResult"], "properties": { "previousResultHash": { "$ref": "#/$defs/hash" }, "previousStatus": { "const": "INFRA_FAILURE" }, "reason": { "type": "string", "minLength": 1 }, "archivedResult": { "type": "string", "pattern": "^runs/replacements/[0-9a-f]{16}/[0-9a-f]{64}\\.json$" } }, "additionalProperties": false },
    "auditRecord": { "type": "object", "required": ["runId"], "properties": { "runId": { "type": "string", "pattern": "^[0-9a-f]{16}$" }, "queueAudit": { "$ref": "#/$defs/queueAudit" }, "replacementAudit": { "$ref": "#/$defs/replacementAudit" } }, "anyOf": [{ "required": ["queueAudit"] }, { "required": ["replacementAudit"] }], "additionalProperties": false },
    "provenance": { "type": "object", "required": ["gitCommit", "files", "sdkVersion"], "properties": { "gitCommit": { "type": ["string", "null"] }, "files": { "type": "object", "additionalProperties": { "$ref": "#/$defs/hash" } }, "sdkVersion": { "type": "string", "minLength": 1 } }, "additionalProperties": false }
  },
  "additionalProperties": false
}
