{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/deterministic-subagent-benchmark/routing-evaluation-inputs.schema.json",
  "title": "Replayable routing evaluator inputs",
  "type": "object",
  "required": ["schemaVersion", "recordKind", "evaluatorImage", "fixtures", "candidates"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "recordKind": { "const": "routing-evaluation-inputs" },
    "evaluatorImage": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "fixtures": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["fixtureId", "manifestHash", "files"],
        "properties": {
          "fixtureId": { "type": "string", "minLength": 1 },
          "manifestHash": { "$ref": "#/$defs/hash" },
          "files": { "$ref": "#/$defs/files" }
        }
      }
    },
    "candidates": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["runId", "candidateHash", "files"],
        "properties": {
          "runId": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
          "candidateHash": { "$ref": "#/$defs/hash" },
          "files": { "$ref": "#/$defs/files" }
        }
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "files": {
      "type": "object", "minProperties": 1,
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["sha256", "bytes", "base64"],
        "properties": {
          "sha256": { "$ref": "#/$defs/hash" },
          "bytes": { "type": "integer", "minimum": 0 },
          "base64": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}
