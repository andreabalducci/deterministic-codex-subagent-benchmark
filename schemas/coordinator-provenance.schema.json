{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/codex-benchmark/coordinator-provenance.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "recordKind", "estimand", "sourceRepository", "campaignRunner", "analysisImplementation", "coordinatorTreatments", "frozenWorkerPolicy", "machines"],
  "properties": {
    "schemaVersion": {"const": 1},
    "recordKind": {"const": "coordinator-provenance"},
    "estimand": {"const": "live-coordinator-with-frozen-workers"},
    "sourceRepository": {"type": "object", "additionalProperties": false,
      "required": ["url", "commit", "dirty"],
      "properties": {"url": {"type": ["string", "null"]}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "dirty": {"const": false}}
    },
    "campaignRunner": {"$ref": "#/$defs/component"},
    "analysisImplementation": {"$ref": "#/$defs/component"},
    "coordinatorTreatments": {"type": "array", "minItems": 2,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["id", "model", "reasoningEffort", "serviceTier", "toolVersion"],
        "properties": {"id": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "reasoningEffort": {"enum": ["low", "medium", "high"]}, "serviceTier": {"type": "string", "minLength": 1}, "toolVersion": {"type": "string", "minLength": 1}}
      }
    },
    "frozenWorkerPolicy": {"type": "object", "additionalProperties": false,
      "required": ["hash", "treatmentId", "model", "reasoningEffort"],
      "properties": {"hash": {"$ref": "#/$defs/hash"}, "treatmentId": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "reasoningEffort": {"enum": ["low", "medium", "high"]}}
    },
    "machines": {"type": "array", "minItems": 3,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["id", "platform"], "properties": {"id": {"type": "string", "minLength": 1}, "platform": {"type": "string", "minLength": 1}}}
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "component": {"type": "object", "additionalProperties": false,
      "required": ["name", "version", "sha256"],
      "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}}}
  }
}
