{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/deterministic-subagent-benchmark/routing-provenance.schema.json",
  "title": "Routing campaign provenance",
  "type": "object",
  "required": [
    "schemaVersion", "recordKind", "sourceRepository", "campaignRunner",
    "analysisImplementation", "configurations", "evaluator", "machines"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "recordKind": { "const": "routing-provenance" },
    "sourceRepository": {
      "type": "object",
      "required": ["url", "commit", "dirty"],
      "properties": {
        "url": { "type": ["string", "null"], "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "dirty": { "const": false }
      },
      "additionalProperties": false
    },
    "campaignRunner": { "$ref": "#/$defs/versionedComponent" },
    "analysisImplementation": { "$ref": "#/$defs/versionedComponent" },
    "configurations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "model", "reasoningEffort", "serviceTier", "toolVersion"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "reasoningEffort": { "type": "string", "minLength": 1 },
          "serviceTier": { "type": "string", "minLength": 1 },
          "toolVersion": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "evaluator": {
      "type": "object",
      "required": ["name", "version", "imageDigest"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "imageDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "machines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "platform"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "platform": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "versionedComponent": {
      "type": "object",
      "required": ["name", "version", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
