{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/codex-benchmark/routing-result.schema.json",
  "type": "object",
  "required": ["schemaVersion", "recordKind", "protocolHash", "planHash", "runtimeManifestHash", "preflightReportHash", "capabilityDigest", "runId", "familyId", "fixtureId", "replicate", "machineId", "orderPosition", "treatmentId", "model", "reasoningEffort", "status", "failureKind", "fixtureManifestHash", "promptHash", "candidateHash", "transcriptHash", "generation", "usage", "evaluation", "generationDurationSeconds", "evaluationDurationSeconds", "totalDurationSeconds", "provenance"],
  "properties": {
    "schemaVersion": {"const": 2}, "recordKind": {"const": "routing-result"},
    "protocolHash": {"$ref": "#/$defs/hash"}, "planHash": {"$ref": "#/$defs/hash"},
    "runtimeManifestHash": {"$ref": "#/$defs/hash"},
    "preflightReportHash": {"$ref": "#/$defs/hash"}, "capabilityDigest": {"$ref": "#/$defs/hash"},
    "runId": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "familyId": {"type": "string", "minLength": 1}, "fixtureId": {"type": "string", "minLength": 1},
    "replicate": {"type": "integer", "minimum": 0}, "machineId": {"type": "string", "minLength": 1},
    "orderPosition": {"type": "integer", "minimum": 0}, "treatmentId": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1}, "reasoningEffort": {"enum": ["low", "medium", "high"]},
    "status": {"enum": ["PASS", "CANDIDATE_FAILURE", "INFRA_FAILURE"]},
    "failureKind": {"type": ["string", "null"], "enum": [null, "generation-launcher", "generation-timeout", "generation-output-limit", "generation-transcript", "generation-unavailable", "generation-exit", "runtime-drift", "evaluation-launcher", "evaluation-failed"]},
    "fixtureManifestHash": {"$ref": "#/$defs/hash"}, "promptHash": {"$ref": "#/$defs/hash"},
    "candidateHash": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "transcriptHash": {"$ref": "#/$defs/hash"}, "generation": {"$ref": "#/$defs/generation"},
    "usage": {"$ref": "#/$defs/usage"}, "evaluation": {"$ref": "#/$defs/evaluation"},
    "generationDurationSeconds": {"type": "number", "minimum": 0},
    "evaluationDurationSeconds": {"type": ["number", "null"], "minimum": 0},
    "totalDurationSeconds": {"type": "number", "minimum": 0}, "provenance": {"$ref": "#/$defs/provenance"}
  },
  "allOf": [{"if": {"properties": {"status": {"const": "PASS"}}}, "then": {"properties": {"failureKind": {"const": null}}}, "else": {"properties": {"failureKind": {"type": "string"}}}}],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableToken": {"type": ["integer", "null"], "minimum": 0},
    "usage": {"type": "object", "required": ["inputTokens", "cachedInputTokens", "outputTokens", "reasoningOutputTokens", "cacheWriteInputTokens", "totalTokens"], "properties": {"inputTokens": {"$ref": "#/$defs/nullableToken"}, "cachedInputTokens": {"$ref": "#/$defs/nullableToken"}, "outputTokens": {"$ref": "#/$defs/nullableToken"}, "reasoningOutputTokens": {"$ref": "#/$defs/nullableToken"}, "cacheWriteInputTokens": {"$ref": "#/$defs/nullableToken"}, "totalTokens": {"$ref": "#/$defs/nullableToken"}}, "additionalProperties": false},
    "image": {"type": ["object", "null"], "required": ["tag", "id", "repoDigests", "os", "architecture", "specHash"], "properties": {"tag": {"type": "string"}, "id": {"type": "string"}, "repoDigests": {"type": "array", "items": {"type": "string"}}, "os": {"type": ["string", "null"]}, "architecture": {"type": ["string", "null"]}, "specHash": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}}, "additionalProperties": false},
    "generation": {"type": "object", "required": ["backend", "isolation", "generatorImage", "codexVersion", "attemptHash", "requestedModel", "requestedReasoningEffort", "requestedServiceTier", "fastMode", "multiAgent", "observedModel", "serviceTier", "runtimeVerification"], "properties": {"backend": {"const": "docker"}, "isolation": {"const": "container-strong"}, "generatorImage": {"$ref": "#/$defs/image"}, "codexVersion": {"type": ["string", "null"]}, "attemptHash": {"$ref": "#/$defs/hash"}, "requestedModel": {"type": "string"}, "requestedReasoningEffort": {"enum": ["low", "medium", "high"]}, "requestedServiceTier": {"enum": ["priority", "default"]}, "fastMode": {"type": "boolean"}, "multiAgent": {"const": false}, "observedModel": {"type": ["string", "null"]}, "serviceTier": {"type": ["string", "null"]}, "runtimeVerification": {"enum": ["telemetry-confirmed", "cli-request-and-success"]}}, "additionalProperties": false},
    "evaluation": {"type": "object", "required": ["backend", "evaluatorProfile", "evaluatorImage", "reportHash"], "properties": {"backend": {"enum": ["docker", "native"]}, "evaluatorProfile": {"type": ["string", "null"]}, "evaluatorImage": {"$ref": "#/$defs/image"}, "reportHash": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}}, "additionalProperties": false},
    "provenance": {"type": "object", "required": ["gitCommit", "files", "platform"], "properties": {"gitCommit": {"type": ["string", "null"]}, "files": {"type": "object", "additionalProperties": {"$ref": "#/$defs/hash"}}, "platform": {"type": "object", "required": ["system", "release", "machine", "python"], "properties": {"system": {"type": "string"}, "release": {"type": "string"}, "machine": {"type": "string"}, "python": {"type": "string"}}, "additionalProperties": false}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
