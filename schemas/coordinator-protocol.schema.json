{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/codex-benchmark/coordinator-protocol.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordKind", "protocolId", "seed", "bootstrapSeed", "bootstrapSamples", "familywiseAlpha", "replicatesPerFixture", "machines", "fixtureIds", "sourceBinding", "coordinatorTreatments", "workerPolicy", "executionEnvelope", "acceptance", "analysis"],
  "properties": {
    "schemaVersion": {"const": 1},
    "recordKind": {"const": "coordinator-protocol"},
    "protocolId": {"type": "string", "minLength": 1},
    "seed": {"type": "string", "minLength": 16},
    "bootstrapSeed": {"type": "string", "minLength": 16},
    "bootstrapSamples": {"type": "integer", "minimum": 1000},
    "familywiseAlpha": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 0.5},
    "replicatesPerFixture": {"type": "integer", "minimum": 1},
    "machines": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "fixtureIds": {"type": "array", "minItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "sourceBinding": {"type": "object", "additionalProperties": false, "required": ["catalogHash", "fixtureManifestHashes"], "properties": {"catalogHash": {"$ref": "#/$defs/hash"}, "fixtureManifestHashes": {"type": "object", "minProperties": 12, "maxProperties": 12, "additionalProperties": {"$ref": "#/$defs/hash"}}}},
    "coordinatorTreatments": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/treatment"}},
    "workerPolicy": {"$ref": "#/$defs/workerPolicy"},
    "executionEnvelope": {"$ref": "#/$defs/envelope"},
    "acceptance": {"$ref": "#/$defs/acceptance"},
    "analysis": {"$ref": "#/$defs/analysis"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "effort": {"enum": ["low", "medium", "high"]},
    "treatment": {"type": "object", "additionalProperties": false, "required": ["id", "model", "reasoningEffort"], "properties": {"id": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "reasoningEffort": {"$ref": "#/$defs/effort"}}},
    "workerPolicy": {"type": "object", "additionalProperties": false, "required": ["treatmentId", "model", "reasoningEffort", "workerCount", "concurrency", "maxSpawnDepth", "freshContext", "prompts"], "properties": {"treatmentId": {"type": "string"}, "model": {"type": "string"}, "reasoningEffort": {"$ref": "#/$defs/effort"}, "workerCount": {"const": 3}, "concurrency": {"const": 3}, "maxSpawnDepth": {"const": 1}, "freshContext": {"const": true}, "prompts": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 100}}}},
    "envelope": {"type": "object", "additionalProperties": false, "required": ["codexVersion", "serviceTier", "fastMode", "multiAgent", "ephemeral", "ignoreUserConfig", "ignoreRules", "network"], "properties": {"codexVersion": {"type": "string", "minLength": 1}, "serviceTier": {"enum": ["default", "priority"]}, "fastMode": {"type": "boolean"}, "multiAgent": {"const": true}, "ephemeral": {"const": true}, "ignoreUserConfig": {"const": true}, "ignoreRules": {"const": true}, "network": {"const": true}}},
    "acceptance": {"type": "object", "additionalProperties": false, "required": ["requireExactWorkerPrompts", "requireAllWorkersCompleted", "requireNoNestedDelegation", "requireIntegrationPass", "maximumUnresolvedConflicts"], "properties": {"requireExactWorkerPrompts": {"const": true}, "requireAllWorkersCompleted": {"const": true}, "requireNoNestedDelegation": {"const": true}, "requireIntegrationPass": {"const": true}, "maximumUnresolvedConflicts": {"const": 0}}},
    "analysis": {"type": "object", "additionalProperties": false, "required": ["candidateId", "absoluteQualityFloor", "nonInferiorityMargin", "decisionComparatorId", "minimumDecisionGain"], "properties": {"candidateId": {"type": "string"}, "absoluteQualityFloor": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "nonInferiorityMargin": {"type": "number", "minimum": 0, "maximum": 0.5}, "decisionComparatorId": {"type": "string"}, "minimumDecisionGain": {"type": "number", "minimum": 0, "maximum": 1}}}
  }
}
