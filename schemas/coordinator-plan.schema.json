{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/codex-benchmark/coordinator-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordKind", "protocolHash", "workerPolicyHash", "jobs"],
  "properties": {
    "schemaVersion": {"const": 1},
    "recordKind": {"const": "coordinator-plan"},
    "protocolHash": {"$ref": "#/$defs/hash"},
    "workerPolicyHash": {"$ref": "#/$defs/hash"},
    "jobs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/job"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "job": {"type": "object", "additionalProperties": false, "required": ["runId", "fixtureId", "replicate", "machineId", "orderPosition", "coordinatorTreatmentId", "coordinatorModel", "coordinatorReasoningEffort", "workerPolicyHash"], "properties": {"runId": {"type": "string", "pattern": "^coord-[0-9a-f]{24}$"}, "fixtureId": {"type": "string"}, "replicate": {"type": "integer", "minimum": 1}, "machineId": {"type": "string"}, "orderPosition": {"type": "integer", "minimum": 1}, "coordinatorTreatmentId": {"type": "string"}, "coordinatorModel": {"type": "string"}, "coordinatorReasoningEffort": {"enum": ["low", "medium", "high"]}, "workerPolicyHash": {"$ref": "#/$defs/hash"}}}
  }
}
